# =============================================================================
# Fitness Buddy – Environment Configuration
# IBM watsonx.ai / Granite (IBM Cloud Lite) Edition
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets to version control.
# Get free credentials at: https://cloud.ibm.com/registration (Lite plan)

# -----------------------------------------------------------------------------
# IBM watsonx.ai / Granite Configuration (IBM Cloud Lite)
# -----------------------------------------------------------------------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model IDs
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
GRANITE_VISION_MODEL_ID=ibm/granite-3-8b-instruct

# IBM Cloud IAM
IBM_CLOUD_IAM_URL=https://iam.cloud.ibm.com/identity/token

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_NAME=Fitness Buddy
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_random_secret_key_32chars

# -----------------------------------------------------------------------------
# Granite / LLM Parameters
# -----------------------------------------------------------------------------
GRANITE_MAX_NEW_TOKENS=1024
GRANITE_MIN_NEW_TOKENS=10
GRANITE_TEMPERATURE=0.7
GRANITE_TOP_P=0.95
GRANITE_TOP_K=50
GRANITE_REPETITION_PENALTY=1.1
GRANITE_DECODING_METHOD=greedy

# -----------------------------------------------------------------------------
# Operational Guardrails
# -----------------------------------------------------------------------------
MAX_TOKENS_PER_REQUEST=1024
MAX_AGENT_ITERATIONS=10
MAX_EXECUTION_TIME_SECONDS=30
API_RATE_LIMIT_PER_MINUTE=60
MONTHLY_TOKEN_BUDGET=500000
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

# -----------------------------------------------------------------------------
# Security Guardrails
# -----------------------------------------------------------------------------
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_JAILBREAK_DETECTION=true
ENABLE_SQL_INJECTION_PREVENTION=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8501

# -----------------------------------------------------------------------------
# Data Guardrails
# -----------------------------------------------------------------------------
ENABLE_PII_DETECTION=true
ENABLE_DATA_MASKING=true
ENABLE_AUDIT_TRAIL=true
AUDIT_LOG_PATH=logs/audit.log

# -----------------------------------------------------------------------------
# Content Guardrails
# -----------------------------------------------------------------------------
ENABLE_TOXICITY_FILTER=true
ENABLE_HALLUCINATION_DETECTION=true
ENABLE_FACTUAL_VALIDATION=true

# -----------------------------------------------------------------------------
# Human-in-the-Loop
# -----------------------------------------------------------------------------
ENABLE_HUMAN_APPROVAL=true
HITL_APPROVAL_TIMEOUT_SECONDS=300
ESCALATION_EMAIL=admin@fitnessbuddy.local

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
